// Prisma schema for AssisCore

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

enum Visibility {
  public
  private
}

enum ProjectRole {
  OWNER
  MAINTAINER
  COLLABORATOR
  VIEWER
}

enum ProjectStatus {
  draft
  building
  ready
  deploying
  error
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                     String                  @id @default(cuid())
  email                  String?                 @unique
  password               String?
  name                   String?
  plan                   Plan                    @default(FREE)
  tokens                 Int                     @default(500)
  githubLinked           Boolean                 @default(false)
  githubUsername         String?
  projects               Project[]
  projectMembers         ProjectMember[]
  orgMembers             OrgMember[]
  auditLogs              AuditLog[]
  tokenTransactions      TokenTransaction[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  Payment                Payment[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
}

model Project {
  id               String            @id @default(cuid())
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id])
  orgId            String?
  organization     Organization?     @relation(fields: [orgId], references: [id])
  visibility       Visibility        @default(public)
  title            String
  type             String
  spec             Json
  files            Json?
  previewUrl       String?
  repoUrl          String?
  deployUrl        String?
  deployProvider   String?
  domain           String?
  lastDeployedAt   DateTime?
  status           ProjectStatus     @default(draft)
  likes            Int               @default(0)
  tags             String[]          @default([])
  // fork/upstream relationship
  forkOfId         String?
  forkOf           Project?          @relation("ForkUpstream", fields: [forkOfId], references: [id])
  forks            Project[]         @relation("ForkUpstream")
  forkBase         Json?
  upstreamMergedAt DateTime?
  createdAt        DateTime          @default(now())
  generations      Generation[]
  patches          Patch[]
  snapshots        ProjectSnapshot[]
  versions         ProjectVersion[]
  members          ProjectMember[]
  invites          ProjectInvite[]
  auditLogs        AuditLog[]

  @@index([ownerId])
  @@index([orgId])
  @@index([status])
  @@index([visibility, createdAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  role      ProjectRole
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvite {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  email     String
  role      ProjectRole
  token     String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  invitedBy String
  createdAt DateTime    @default(now())

  @@index([projectId, email])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  tokens    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrgMember[]
  projects Project[]
  invites  OrgInvite[]
}

model OrgMember {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  role      OrgRole
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

model OrgInvite {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  email     String
  role      OrgRole
  token     String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  invitedBy String
  createdAt DateTime     @default(now())

  @@index([orgId, email])
}

model AuditLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Generation {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  costTokens Int
  logs       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model Patch {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  diff       String        @db.Text
  status     ProjectStatus @default(draft)
  notes      String?
  costTokens Int
  createdAt  DateTime      @default(now())
}

model TokenTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  amount     Int
  tokens     Int?
  status     String
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

model ProjectSnapshot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  label     String
  files     Json
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  label     String
  files     Json
  createdBy String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

enum NotificationType {
  GENERATION_READY
  GENERATION_ERROR
  PATCH_READY
  PATCH_ERROR
  DEPLOY_READY
  DEPLOY_ERROR
  BILLING_CREATED
  BILLING_SUCCEEDED
  BILLING_CANCELED
  PROJECT_OWNERSHIP_TRANSFERRED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  emailOn     Boolean  @default(true)
  locale      String   @default("ru")
  genReady    Boolean  @default(true)
  genError    Boolean  @default(true)
  patchReady  Boolean  @default(true)
  patchError  Boolean  @default(true)
  deployReady Boolean  @default(true)
  deployError Boolean  @default(true)
  billing     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CodeIndex {
  id        String   @id @default(cuid())
  projectId String
  path      String
  chunkId   String
  content   String
  vector    Json
  createdAt DateTime @default(now())

  @@index([projectId, path])
}
